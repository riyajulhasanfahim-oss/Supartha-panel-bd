        "customerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["credit", "debit", "order_charge", "refund", "adjustment"] },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "type", "amount", "balanceBefore", "balanceAfter", "referenceId", "createdAt"]
    },
    "ApiRequestLog": {
      "title": "ApiRequestLog",
      "description": "Audit and telemetry log of inbound Public API Gateway calls.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "keyId": { "type": "string", "maxLength": 64 },
        "installationId": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 40 },
        "httpStatus": { "type": "number" },
        "success": { "type": "boolean" },
        "latencyMs": { "type": "number" },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "errorMessage": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "httpStatus", "success", "createdAt"]
    },
    "WebsiteInstallation": {
      "title": "WebsiteInstallation",
      "description": "Registry of connected reseller websites and panels using the Supartha Panel Reseller API.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "installationId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 200 },
        "appVersion": { "type": "string", "maxLength": 24 },
        "apiLocked": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended", "revoked"] },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "installationId", "customerId", "buyerName", "domain", "apiLocked", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account profiles and balances (PII strictly owner/admin only)."
    },
    "/adminUsers/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin accounts for RBAC checks."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Public/customer-readable SMM platform categories; admin write-only."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Public/customer-readable SMM services catalog; admin write-only."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer SMM orders; users may create pending orders and read their own orders."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Customer payment records; users read own payments, admins manage approvals."
    },
    "/paymentMethods/{methodId}": {
      "schema": { "$ref": "#/entities/PaymentMethod" },
      "description": "Active deposit payment methods readable by customers; admin write-only."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Customer wallet transaction ledger; read-only for owner, atomic write for order payment/admin."
    },
    "/apiProviders/{providerId}": {
      "schema": { "$ref": "#/entities/ApiProvider" },
      "description": "Admin-only external SMM provider credentials."
    },
    "/apiCustomers/{customerId}": {
      "schema": { "$ref": "#/entities/ApiCustomer" },
      "description": "Supartha Panel API Gateway customer accounts and API balances."
    },
    "/apiKeys/{keyId}": {
      "schema": { "$ref": "#/entities/ApiKey" },
      "description": "Hashed API key credentials for Supartha Panel Public API."
    },
    "/apiOrders/{apiOrderId}": {
      "schema": { "$ref": "#/entities/ApiOrder" },
      "description": "API Gateway orders isolating upstream provider metadata."
    },
    "/apiTransactions/{txnId}": {
      "schema": { "$ref": "#/entities/ApiTransaction" },
      "description": "Immutable API Customer balance ledger."
    },
    "/apiRequestLogs/{logId}": {
      "schema": { "$ref": "#/entities/ApiRequestLog" },
      "description": "Public API Gateway request logs and rate-limit telemetry."
    },
    "/websiteInstallations/{installationId}": {
      "schema": { "$ref": "#/entities/WebsiteInstallation" },
      "description": "Sold buyer website installations locked to Supartha Panel API."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Platform white-label settings (publicBrand readable, admin-only secrets/config)."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer support tickets; owner and admin access."
    },
    "/supportTickets/{ticketId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/TicketMessage" },
      "description": "Customer and admin conversation messages under a support ticket."
    },
    "/supportTickets/{ticketId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/TicketMessage" },
      "description": "Legacy subcollection alias for customer and admin conversation replies."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications; owner can read and mark read."
    },
    "/adminNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Admin-only system event alerts."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable admin audit log records."
    }
  }
}
